<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- Démarrage de l'app réelle dans un TestServer : vérifie le graphe DI de production -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <!-- Mesure de couverture : collectée par la CI et publiée en artefact, avec un seuil
         plancher pour qu'une régression de couverture soit visible. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Aligne EF Core sur la version utilisée par Wazap.Infrastructure (évite le conflit MSB3277) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <!-- Fournisseur InMemory : tests des services applicatifs sans base PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <!-- Fournisseur RELATIONNEL sans serveur (SQLite en mémoire) : exerce les chemins de code
         qui n'existent QUE sur un fournisseur relationnel — `ExecuteUpdate`/`ExecuteDelete`
         conditionnels, contraintes d'unicité — et qui n'étaient donc validés par AUCUN test
         (le fournisseur InMemory les refuse ou les ignore).
         ⚠️ Testcontainers.PostgreSql a été ÉCARTÉ : il tire SSH.NET 2024.1.0, qui porte une
         vulnérabilité de gravité élevée (GHSA-q939-rpr3-3284) — elle casserait le build
         (`-warnaserror`) et l'audit de vulnérabilités de la CI.
         ✅ B-19 est traité SANS lui : PostgreSQL réel est fourni par un « service container »
         du pipeline (`.github/workflows/ci.yml`) et les tests le rejoignent via
         `WAZAP_TEST_POSTGRES`. Voir `PostgresHarness` / `PostgresMoneyPathsTests`. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- Client PostgreSQL, utilisé DIRECTEMENT par le harnais de tests réels (création d'une
         base dédiée par test, application des migrations). Même version que celle déjà tirée
         par Npgsql.EntityFrameworkCore.PostgreSQL : aucune dépendance nouvelle dans le graphe. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wazap.Domain\Wazap.Domain.csproj" />
    <ProjectReference Include="..\..\src\Wazap.Application\Wazap.Application.csproj" />
    <ProjectReference Include="..\..\src\Wazap.Infrastructure\Wazap.Infrastructure.csproj" />
    <!-- Services applicatifs testés : LeadConversion, ColisSur, RiderService (couche API) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\Wazap.API\Wazap.API.csproj" />
  </ItemGroup>

</Project>
