@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar__brand">
            <div class="brand__logo" aria-hidden="true">⚡</div>
            <div class="brand__text">
                <span class="brand__name">WAZAP</span>
                <span class="brand__tagline">Votre livraison en un éclair</span>
            </div>
        </div>

        <nav class="sidebar__nav">
            <span class="nav__section">Pilotage</span>
            <a class="nav__item nav__item--active" href="/">
                <span class="nav__icon">📊</span> Tableau de bord
            </a>
            <a class="nav__item" href="#">
                <span class="nav__icon">🧾</span> Commandes
            </a>
            <a class="nav__item" href="#">
                <span class="nav__icon">🛵</span> Livreurs
            </a>
            <a class="nav__item" href="#">
                <span class="nav__icon">🏪</span> Vendeurs
            </a>

            <span class="nav__section">Système</span>
            <a class="nav__item" href="#">
                <span class="nav__icon">⚙️</span> Paramètres
            </a>
        </nav>

        <div class="sidebar__footer">
            <div class="user">
                <div class="user__avatar">A</div>
                <div class="user__meta">
                    <span class="user__name">Admin WAZAP</span>
                    <span class="user__role">Administrateur</span>
                </div>
            </div>
        </div>
    </aside>

    <main class="main">
        <header class="topbar">
            <div>
                <h1 class="topbar__title">Tableau de bord</h1>
                <p class="topbar__subtitle">Vue d'ensemble de l'activité en temps réel</p>
            </div>
            <div class="topbar__actions">
                <span class="topbar__live"><span class="topbar__dot"></span> Live</span>
                <a class="btn btn--primary" href="#">Nouvelle commande</a>
            </div>
        </header>

        <div class="main__content">
            @Body
        </div>
    </main>
</div>
